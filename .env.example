SERVICE_HOST=127.0.0.1
SERVICE_PORT=8000
LOG_DIR=logs
COMPUTE_DEVICE=cpu
ARTIFACT_ROOT=/var/lib/sensitive-checker/music
MUSIC_ARTIFACT_MAX_SIZE=104857600
MUSIC_ARTIFACT_TTL_SECONDS=900
MUSIC_PROCESS_TIMEOUT_SECONDS=300
MUSIC_MAX_CONCURRENT_DOWNLOADS=2
MUSIC_CAPACITY_WAIT_SECONDS=1
MUSIC_CLEANUP_INTERVAL_SECONDS=60
IMAGE_UPLOAD_MAX_SIZE=104857600
IMAGE_SCAN_TEMP_ROOT=/tmp/sensitive-checker/images
YOLO_MODEL_PATH=models/erax_nsfw_yolo11m.pt
VIT_MODEL_NAME=AdamCodd/vit-base-nsfw-detector
